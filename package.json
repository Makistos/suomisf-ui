    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "axios": "^1.21.0",
    "axios-retry": "^4.5.0",
    "chart.js": "^4.6.1",
    "classname": "0.0.0",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "history": "^5.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lodash": "^4.18.1",
    "primeflex": "^4.0.0",
    "primeicons": "^8.0.2",
    "primereact": "^11.2.2",
    "quill": "^2.0.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.4",
    "react-transition-group": "^4.4.5",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "web-vitals": "^6.2.3"
  },
  "scripts": {
    "start": "vite",
    "dev:e2e": "vite --mode e2e",
    "build": "tsc && vite build",
    "build:e2e": "vite build --mode e2e",
    "preview:e2e": "vite preview --mode e2e",
    "serve": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium && playwright test --project=firefox",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:password-reset": "playwright test --project=password-reset",
    "test:e2e:coverage": "E2E_COVERAGE=1 playwright test --project=chromium --workers=4",
    "dev": "vite"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "monocart-coverage-reports": "^3.1.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.62.1",
    "vite": "^8.3.5",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.0.3"
  }
}
